  <meta name="description"
        content="Gaia Belardinelli — research in logic, attention, awareness, and implicit bias.">
  <title>Gaia Belardinelli</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
        rel="stylesheet">

  <style>
    :root {
      color-scheme: dark;
      --bg: #0b0d10;
      --panel: #14171c;
      --line: #232830;
      --text: #e7eaef;
      --muted: #9aa3af;
      --accent: #4fd1c5;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", sans-serif;
      font-size: 15px;
      line-height: 1.75;
      -webkit-font-smoothing: antialiased;
    }

    main {
      max-width: 960px;
      margin: auto;
      padding: 56px 28px 32px;
    }

    a {
      color: var(--accent);
      text-decoration: none;
      text-underline-offset: 4px;
    }

    a:hover { text-decoration: underline; }
    a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 22px;
      margin-bottom: 56px;
    }

    nav a {
      color: var(--muted);
      font-size: 13px;
    }

    .label, .meta {
      font-family: "JetBrains Mono", monospace;
      font-size: 11px;
      color: var(--muted);
    }

    .label {
      text-transform: uppercase;
      letter-spacing: .14em;
    }

    .hero {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 28px;
    }

    h1 {
      font-size: clamp(28px, 5vw, 38px);
      font-weight: 500;
      letter-spacing: -.035em;
      line-height: 1.2;
      margin: 12px 0;
    }

    .subtitle {
      max-width: 54ch;
      margin: 0;
      color: var(--muted);
      font-size: 16px;
    }

    .portrait {
      width: 96px;
      height: 96px;
      flex-shrink: 0;
      border-radius: 50%;
      object-fit: cover;
      filter: grayscale(100%);
      border: 1px solid var(--line);
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 24px;
      font-family: "JetBrains Mono", monospace;
      font-size: 12px;
    }

    .bio { max-width: 68ch; margin-top: 36px; }
    p { color: var(--muted); }
    strong { color: var(--text); font-weight: 500; }

    section { margin-top: 56px; scroll-margin-top: 24px; }

    h2 {
      font-size: 19px;
      font-weight: 500;
      margin: 0 0 22px;
    }

    h3 {
      font-size: 15px;
      font-weight: 500;
      line-height: 1.5;
      margin: 0 0 10px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .card {
      padding: 22px;
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
    }

    .card p { margin: 0; font-size: 14px; }

    .row {
      padding: 20px 0;
      border-top: 1px solid var(--line);
    }

    .row p { margin: 6px 0 0; font-size: 14px; }
    .row h3 { margin: 0; }

    .education {
      padding: 0;
      list-style: none;
      color: var(--muted);
      font-size: 14px;
    }

    .education li { margin: 8px 0; }

    footer {
      margin-top: 64px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
    }

    @media (max-width: 600px) {
      main { padding: 32px 22px; }
      nav { margin-bottom: 40px; gap: 16px; }
      .hero { align-items: flex-start; }
      .portrait { width: 64px; height: 64px; }
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

